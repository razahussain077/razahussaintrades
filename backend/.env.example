# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/trades.db

# Optional: override API base URLs
# BINANCE_BASE_URL=https://api.binance.com
# BINANCE_FUTURES_URL=https://fapi.binance.com
# BYBIT_BASE_URL=https://api.bybit.com
# OKX_BASE_URL=https://www.okx.com
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Risk settings
# MAX_LEVERAGE=20.0
# MIN_CONFIDENCE_SCORE=60.0
# DEFAULT_RISK_PCT=1.0

# Trading-cost model (used by backtest equity curve + live signal net R/R)
# Defaults assume Binance USDⓂ-Futures retail tier (taker 0.04%, maker 0.02%).
# FEE_BPS_TAKER=4.0
# FEE_BPS_MAKER=2.0
# BACKTEST_RISK_PER_TRADE_PCT=1.0
# BACKTEST_DEFAULT_FUNDING_RATE_PER_8H=0.0001
# BACKTEST_INCLUDE_COSTS=true

# CORS — comma-separated list of allowed origins for production. Use "*" only
# during local development. When ALLOWED_ORIGINS == "*", credentials are
# disabled per the CORS spec.
# ALLOWED_ORIGINS=https://your-frontend.example.com,https://staging.example.com

# Lower-timeframe entry refinement (PR5).
# When LTF_ENTRY_REQUIRED=true, signals are dropped unless the 5m
# sweep+reclaim trigger fires AND 1h/4h HTF bias agrees with the signal
# direction. Default is false (soft +5/-5 confidence bonus only).
# LTF_ENTRY_REQUIRED=false
# LTF_TRIGGER_TIMEFRAME=5m
# LTF_TRIGGER_LOOKBACK=24
# LTF_TRIGGER_RECLAIM_BARS=3

# Telegram push notifications (PR6).
# Get a bot token from @BotFather, then `/start` your bot in your account
# and grab the chat id from any update at
# https://api.telegram.org/bot<TOKEN>/getUpdates. The notifier is a no-op
# until both values are set.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFICATIONS_ENABLED=true
# DASHBOARD_URL=https://your-frontend.example.com
